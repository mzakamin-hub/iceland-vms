// Optional (NOT installed): let local, active members of wheel manage VMs without a password.
// Copy to /etc/polkit-1/rules.d/49-iceland-vms.rules to enable.
polkit.addRule(function(action, subject) {
    if (action.id == "org.iceland.vms.manage" && subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
