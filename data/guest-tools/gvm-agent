#!/bin/sh
# gvm-agent: lets the iceland-vms host shut this guest down cleanly.
# Reads one command per line from the virtio console /dev/hvc0 (crosvm --serial hardware=virtio-console):
#   ping -> pong, poweroff, reboot, ip -> "ip <address>"
# crosvm's power button does nothing for arm64 device-tree guests, so this is the clean-stop path.
#
# gvm-agent --setup (ExecStartPre, before the display manager): applies the host's per-run desktop flags
# from the 9p share (tag gvmshare; the app shares its tools dir itself, so the flags are at the share's top; gvm.sh
# shares a dir with tools/ - 0.2-24: both layouts, before only tools/ was read, so the app's flags never applied).
# Every run lists the flags it found in /run/gvm-agent.flags.
# gvm-agent --refresh (0.2-24; the app runs it over ssh in a running guest after installing a newer agent): the same
# setup, then the display manager is restarted when its configuration changed and no desktop session is open
# (so an existing VM's greeter turns into the autologin desktop at once).
#   noglamor   -> /etc/X11/xorg.conf.d/20-iceland-noglamor.conf (Xorg modesetting without glamor), else removed
#   wayland    -> the autologin session is a Wayland one (labwc preferred) instead of Xorg
#   zink       -> GL through zink over venus for every program on the virtio-gpu device, Xorg included: a Mesa
#                 driconf file (/usr/share/drirc.d/99-iceland-zink.conf, loader option dri_driver=zink for the
#                 virtio_gpu kernel driver). 0.2-25: no lightdm xserver-command any more (kit-vm24b: lightdm
#                 started no X server with "xserver-command=env ... X"; V5Z earlier: "zink no session")
#   native     -> the msm native context: the share's nctx-mesa-*.tar.gz (freedreno with the virtio KMD) is unpacked
#                 under /usr/lib64/iceland-nctx and made the system's Mesa for this boot's mode through
#                 /etc/ld.so.conf.d/iceland-nctx.conf + ldconfig (searched before /usr/lib64: Xorg, the display
#                 manager, Wayland compositors and every session use it) + a Vulkan ICD file; Fedora's Mesa files
#                 are not touched and the files are removed again in other modes (Fedora 44+ aarch64 guests only)
# gvm-agent --dmcheck (0.2-25; started 25 s after a --refresh that restarted the display manager): if no desktop
# session came up, the guest is rebooted once (fresh boots only; the agent's setup then applies everything before
# the display manager starts, the path proven by kit-vm24 A-5).
# A newer gvm-agent in the share replaces the installed one first (0.2-23).
#   autologin  -> autologin of the cloud-init user in lightdm / GDM (touch / the host OSK cannot type into a
#                 greeter in the VM window), else our autologin drop-ins are removed
if [ "${1:-}" = --setup ] || [ "${1:-}" = --refresh ]; then
	mode=$1
	share=/mnt/gvmshare
	mkdir -p "$share"
	mountpoint -q "$share" || mount -t 9p -o trans=virtio,version=9p2000.L,ro gvmshare "$share" 2>/dev/null
	ft=$share/tools; [ -d "$ft" ] || ft=$share
	dmconf() { cat /etc/lightdm/lightdm.conf.d/5*-iceland-*.conf /etc/gdm/custom.conf /etc/X11/xorg.conf.d/20-iceland-noglamor.conf \
		/usr/share/drirc.d/99-iceland-zink.conf /etc/ld.so.conf.d/iceland-nctx.conf 2>/dev/null | cksum; }
	dm0=$(dmconf)
	# 0.2-23: the app's agent is newer than the installed one (new flags such as native): install it and run its setup
	# (the app shares its tools dir itself as gvmshare: files at the share's top; gvm.sh shares a dir with tools/)
	na=$(ls "$share/gvm-agent" "$share/tools/gvm-agent" 2>/dev/null | head -n1)
	if [ -z "${GVM_AGENT_UPDATED:-}" ] && [ -n "$na" ] && ! cmp -s "$na" /usr/local/sbin/gvm-agent; then
		install -m 755 "$na" /usr/local/sbin/gvm-agent && echo "gvm-agent: updated from the host"
		GVM_AGENT_UPDATED=1 exec /usr/local/sbin/gvm-agent "$mode"
	fi
	fl=""
	for f in noglamor autologin wayland zink native; do [ -f "$ft/$f" ] && fl="$fl $f"; done
	echo "flags:${fl:- none} (share $ft, $mode, agent $(cksum < /usr/local/sbin/gvm-agent 2>/dev/null | cut -d' ' -f1))" > /run/gvm-agent.flags
	echo "gvm-agent: flags:${fl:- none}"
	user=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ {print $1; exit}' /etc/passwd)
	x=/etc/X11/xorg.conf.d/20-iceland-noglamor.conf
	if [ -f "$ft/noglamor" ]; then
		mkdir -p /etc/X11/xorg.conf.d
		printf 'Section "Device"\n\tIdentifier "iceland-virtio-gpu"\n\tDriver "modesetting"\n\tOption "AccelMethod" "none"\nEndSection\n' > "$x"
	else
		rm -f "$x"
	fi
	# zink: the guest's Xorg (glamor) and the sessions' GL through zink over venus (Vulkan) instead of virgl
	# (0.2-24's lightdm xserver-command / profile.d files are removed)
	rm -f /etc/lightdm/lightdm.conf.d/51-iceland-zink.conf /etc/profile.d/iceland-zink.sh
	zc=/usr/share/drirc.d/99-iceland-zink.conf
	if [ -f "$ft/zink" ]; then
		mkdir -p /usr/share/drirc.d
		printf '%s\n' '<?xml version="1.0"?>' '<!-- iceland-vms gvm-agent: zink for the virtio-gpu device (zink flag) -->' \
			'<driconf>' '  <device driver="loader" kernel_driver="virtio_gpu">' \
			'    <application name="iceland-vms zink" executable_regexp=".*">' \
			'      <option name="dri_driver" value="zink" />' '    </application>' '  </device>' '</driconf>' > "$zc"
	else
		rm -f "$zc"
	fi
	# native: the msm native context needs a Mesa whose freedreno has the virtio KMD (Fedora's has msm only, so
	# fd_device_new() refuses the virtio_gpu device and GL falls back to llvmpipe). The host's iceland-vms-guest-mesa
	# puts nctx-mesa-*.tar.gz in the share; it is unpacked under /usr/lib64/iceland-nctx (Fedora's Mesa is untouched)
	# 0.2-25: the dynamic loader, not the environment, selects it (kit-vm24b N-4: profile.d reached shells, but Xorg
	# glamor stayed on virgl: lightdm gives the X server its own environment)
	nd=/usr/lib64/iceland-nctx
	nc=/etc/ld.so.conf.d/iceland-nctx.conf
	nj=/etc/vulkan/icd.d/iceland-nctx-freedreno.json
	# 0.2-23 / 0.2-24 files (environment based): always removed
	rm -f /etc/lightdm/lightdm.conf.d/52-iceland-nctx.conf /etc/profile.d/iceland-nctx.sh /etc/environment.d/60-iceland-nctx.conf
	nt=$(ls "$ft"/nctx-mesa-*.tar.gz 2>/dev/null | tail -n1)
	nos=$(. /etc/os-release 2>/dev/null; [ "${ID:-}" = fedora ] && [ "${VERSION_ID:-0}" -ge 44 ] 2>/dev/null && [ "$(uname -m)" = aarch64 ] && echo ok)
	[ -f "$ft/native" ] && [ -z "$nos" ] && echo "gvm-agent: native flag, but the guest Mesa is for Fedora 44+ aarch64: not used"
	if [ -f "$ft/native" ] && [ -n "$nt" ] && [ -n "$nos" ]; then
		ns=$(sha256sum "$nt" | cut -d' ' -f1)
		if [ "$(cat $nd/.sha256 2>/dev/null)" != "$ns" ]; then
			rm -rf "$nd" && tar -xzf "$nt" -C / && echo "$ns" > "$nd/.sha256" && echo "gvm-agent: guest Mesa $(basename "$nt") unpacked"
		fi
		if [ -f "$nd/.sha256" ] && [ -f "$nd/libgallium-26.2.5.so" ]; then
			if [ "$(cat "$nc" 2>/dev/null)" != "$nd" ]; then
				echo "$nd" > "$nc" && ldconfig && echo "gvm-agent: guest Mesa $nd active (ld.so.conf.d)"
			fi
			mkdir -p /etc/vulkan/icd.d
			cp -f "$nd/freedreno_icd.json" "$nj"
		fi
	elif [ -f "$nc" ] || [ -f "$nj" ]; then
		rm -f "$nc" "$nj" && ldconfig && echo "gvm-agent: guest Mesa off (Fedora's Mesa again)"
	fi
	l=/etc/lightdm/lightdm.conf.d/50-iceland-autologin.conf
	g=/etc/gdm/custom.conf.d-iceland-autologin
	if [ -f "$ft/autologin" ] && [ -n "$user" ]; then
		if [ -d /etc/lightdm ]; then
			mkdir -p /etc/lightdm/lightdm.conf.d
			s=$(ls /usr/share/xsessions 2>/dev/null | sed -n 's/\.desktop$//p' | head -n1)
			# wayland flag: autologin into a Wayland session (labwc preferred) instead of Xorg (V6, 24 Oct)
			if [ -f "$ft/wayland" ]; then
				# v10e: Fedora 44's labwc ships no session file (v10d V5WS: /usr/share/wayland-sessions empty, so the
				# "labwc" rows ran Xfce); write the standard one when labwc is installed
				if [ -x /usr/bin/labwc ] && ! ls /usr/share/wayland-sessions/*.desktop > /dev/null 2>&1; then
					mkdir -p /usr/share/wayland-sessions
					printf '[Desktop Entry]\nName=labwc\nComment=A Wayland stacking compositor\nExec=labwc\nType=Application\nDesktopNames=labwc;wlroots\n' \
						> /usr/share/wayland-sessions/labwc.desktop
				fi
				w=$(ls /usr/share/wayland-sessions 2>/dev/null | sed -n 's/\.desktop$//p' | grep -m1 -E '^labwc$' ||
					ls /usr/share/wayland-sessions 2>/dev/null | sed -n 's/\.desktop$//p' | head -n1)
				[ -n "$w" ] && s=$w
			fi
			# v10f: v10e still logged into Xfce with autologin-session=labwc. Make the choice unambiguous: lightdm
			# must search the wayland-sessions dir, user-session too, and the user's remembered session (AccountsService
			# + ~/.dmrc), which lightdm prefers for an autologin on some versions, is set the same
			printf '[LightDM]\nsessions-directory=/usr/share/lightdm/sessions:/usr/share/xsessions:/usr/share/wayland-sessions\n[Seat:*]\nautologin-user=%s\nautologin-session=%s\nuser-session=%s\n' \
				"$user" "${s:-xfce}" "${s:-xfce}" > "$l"
			a=/var/lib/AccountsService/users/$user
			if [ -d /var/lib/AccountsService/users ]; then   # keep the file's other keys (language, icon)
				[ -f "$a" ] || printf '[User]\nSystemAccount=false\n' > "$a"
				for k in Session XSession; do
					if grep -q "^$k=" "$a"; then sed -i "s/^$k=.*/$k=${s:-xfce}/" "$a"
					else sed -i "/^\[User\]/a $k=${s:-xfce}" "$a"; fi
				done
			fi
			h=$(getent passwd "$user" | cut -d: -f6)
			[ -n "$h" ] && [ -d "$h" ] && printf '[Desktop]\nSession=%s\n' "${s:-xfce}" > "$h/.dmrc" && chown "$user:" "$h/.dmrc"
			getent group autologin > /dev/null || groupadd -r autologin
			usermod -aG autologin "$user"
		fi
		if [ -f /etc/gdm/custom.conf ] && ! grep -q '^AutomaticLogin=' /etc/gdm/custom.conf; then
			cp /etc/gdm/custom.conf "$g"
			sed -i "s/^\[daemon\]/[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=$user/" /etc/gdm/custom.conf
		fi
	else
		rm -f "$l"
		[ -f "$g" ] && mv -f "$g" /etc/gdm/custom.conf
	fi
	# v10g: Fedora's lightdm ignores the labwc session for the autologin (v10f: it ran "Xsession startxfce4" with
	# autologin-session / user-session / AccountsService all set to labwc). The Wayland desktop therefore does not
	# go through lightdm at all: a systemd unit logs the user in on tty1 (PAM "login", logind session of type
	# wayland) and runs labwc with a terminal; lightdm is masked for this boot only (--runtime), so without the
	# flag the next boot is the normal Xorg desktop again.
	wu=/etc/systemd/system/gvm-wayland-session.service
	if [ -f "$ft/wayland" ] && [ -x /usr/bin/labwc ] && [ -n "$user" ]; then
		h=$(getent passwd "$user" | cut -d: -f6)
		mkdir -p "$h/.config/labwc"
		[ -f "$h/.config/labwc/autostart" ] || printf '%s\n' "command -v foot > /dev/null && foot --maximized &" > "$h/.config/labwc/autostart"
		chown -R "$user:" "$h/.config"
		cat > "$wu" <<EOF
[Unit]
Description=iceland gvm: labwc Wayland session for $user on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service gvm-agent.service getty@tty1.service display-manager.service
Conflicts=getty@tty1.service display-manager.service
Wants=gvm-wayland-check.service

[Service]
User=$user
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=labwc XDG_CURRENT_DESKTOP=labwc:wlroots
# v10h: the logind session only gets DRM master while its VT is the active one (v10g: labwc ran, the CRTC kept
# fbcon); -d = wlroots debug log (renderer, allocator, DRM commits) in the journal
ExecStartPre=-+/usr/bin/chvt 1
ExecStart=/usr/bin/labwc -d
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
EOF
		# v10i: the session's FIRST start after the VT handover never got the display (v10h: V5W-4 / -10 black,
		# every restart drawn). gvm-wayland-check waits until labwc should have taken the screen and restarts the
		# session once (per boot) when the primary plane still shows a framebuffer that labwc did not allocate.
		mkdir -p /usr/local/libexec
		cat > /usr/local/libexec/gvm-wayland-check <<'EOF'
#!/bin/sh
# iceland gvm: restart the labwc session once if it did not take the display (owner of the scanout framebuffer)
[ -e /run/gvm-wayland-kicked ] && exit 0
d=/sys/kernel/debug/dri/0
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
owner=""
for i in 1 2 3 4 5 6; do
	sleep 2
	fb=$(awk '/^plane\[/ {p = 1} p && /fb=/ {sub(/.*fb=/, ""); print $1; exit}' $d/state 2>/dev/null)
	owner=$(awk -v id="$fb" 'index($0, "framebuffer[" id "]") == 1 {f = 1} f && /allocated by/ {print $NF; exit}' $d/framebuffer 2>/dev/null)
	[ "$owner" = labwc ] && { echo "gvm-wayland-check: labwc owns the scanout (fb $fb)"; exit 0; }
done
echo "gvm-wayland-check: scanout fb ${fb:-?} owned by ${owner:-?}, not labwc: restarting the session once"
touch /run/gvm-wayland-kicked
systemctl restart --no-block gvm-wayland-session.service
EOF
		chmod 755 /usr/local/libexec/gvm-wayland-check
		cat > /etc/systemd/system/gvm-wayland-check.service <<EOF
[Unit]
Description=iceland gvm: restart the labwc session once if it did not take the display
After=gvm-wayland-session.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/gvm-wayland-check
EOF
		systemctl daemon-reload
		systemctl mask --runtime display-manager.service > /dev/null 2>&1
		systemctl stop display-manager.service getty@tty1.service > /dev/null 2>&1
		systemctl start --no-block gvm-wayland-session.service
	else
		if [ -f "$wu" ]; then
			systemctl stop gvm-wayland-session.service 2> /dev/null
			rm -f "$wu" /etc/systemd/system/gvm-wayland-check.service /usr/local/libexec/gvm-wayland-check
			systemctl daemon-reload
		fi
		systemctl unmask --runtime display-manager.service > /dev/null 2>&1
	fi
	# --refresh in a running guest: apply a changed display-manager configuration now unless a desktop is in use
	if [ "$mode" = --refresh ] && [ "$(dmconf)" != "$dm0" ] && ! [ -f "$wu" -a -f "$ft/wayland" ]; then
		busy=""
		for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
			t=$(loginctl show-session "$sid" -p Type --value 2>/dev/null); c=$(loginctl show-session "$sid" -p Class --value 2>/dev/null)
			[ "$c" = user ] && { [ "$t" = x11 ] || [ "$t" = wayland ]; } && busy=$sid
		done
		if [ -z "$busy" ]; then
			echo "gvm-agent: display manager configuration changed: restarting it"
			systemctl restart display-manager.service
			# fallback: no desktop 25 s later -> one reboot (gvm-agent --dmcheck)
			systemd-run --quiet --collect --unit=gvm-agent-dmcheck --on-active=25 /usr/local/sbin/gvm-agent --dmcheck \
				> /dev/null 2>&1 || true
		else
			echo "gvm-agent: display manager configuration changed; desktop session $busy is open: applies at the next boot"
		fi
	fi
	exit 0
fi
if [ "${1:-}" = --dmcheck ]; then
	# after a --refresh restarted the display manager: no desktop session (x11 / wayland, class user) -> reboot once.
	# Only on a fresh boot (uptime < 10 min: the refresh runs right after the app reaches ssh) and once per
	# configuration (stamp), so it can never loop.
	for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
		t=$(loginctl show-session "$sid" -p Type --value 2>/dev/null); c=$(loginctl show-session "$sid" -p Class --value 2>/dev/null)
		[ "$c" = user ] && { [ "$t" = x11 ] || [ "$t" = wayland ]; } && { echo "gvm-agent: desktop session $sid is up"; exit 0; }
	done
	up=$(cut -d. -f1 /proc/uptime 2>/dev/null); up=${up:-999999}
	st=/var/lib/gvm-agent/dmcheck-reboot
	k=$(cat /etc/lightdm/lightdm.conf.d/5*-iceland-*.conf /etc/gdm/custom.conf /usr/share/drirc.d/99-iceland-zink.conf \
		/etc/ld.so.conf.d/iceland-nctx.conf 2>/dev/null | cksum)
	if [ "$up" -lt 600 ] && [ "$(cat "$st" 2>/dev/null)" != "$k" ] && systemctl is-enabled display-manager.service > /dev/null 2>&1; then
		mkdir -p /var/lib/gvm-agent && echo "$k" > "$st"
		echo "gvm-agent: no desktop session after the display manager restart: rebooting once to apply the settings"
		systemctl reboot
	else
		echo "gvm-agent: no desktop session; no reboot (uptime $up s, already rebooted for this configuration, or no display manager)"
	fi
	exit 0
fi
dev=/dev/hvc0
[ -c "$dev" ] || exec sleep infinity     # no virtio console: nothing to do (and no restart loop)
stty -F "$dev" -echo -onlcr 2>/dev/null
exec 3<>"$dev"
echo "hello $(uname -r)" >&3
while IFS= read -r cmd <&3; do
	case "$cmd" in
	ping) echo pong >&3 ;;
	poweroff) echo "ok poweroff" >&3; systemctl poweroff || poweroff ;;
	reboot) echo "ok reboot" >&3; systemctl reboot || reboot ;;
	ip) echo "ip $(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | head -n1)" >&3 ;;
	esac
done
