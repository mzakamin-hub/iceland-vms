diff --git a/hw/arm/boot.c b/hw/arm/boot.c
index e296b62f..4e0f4bfa 100644
--- a/hw/arm/boot.c
+++ b/hw/arm/boot.c
@@ -661,6 +661,17 @@ int arm_load_dtb(hwaddr addr, const struct arm_boot_info *binfo,
